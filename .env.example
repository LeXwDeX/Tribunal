# Copy this file to .env and fill in the required values. Compose reads .env
# automatically for interpolation; .env is never baked into the image or
# mounted. Keep REVIEW_MASTER_KEY and TRIBUNAL_SESSION_KEY unchanged across
# restarts, or stored credentials and browser sessions become unusable.
#
# Generate each value once without printing it, as described in
# docs/agent-deployment.md#2-准备配置, and store it safely:
# REVIEW_MASTER_KEY: base64, decodes to exactly 32 bytes.
# REVIEW_ADMIN_TOKEN: at least 32 bytes.
# TRIBUNAL_SESSION_KEY: base64, decodes to at least 32 bytes.
# Quote values that contain $ or # with single quotes.
#
# Legacy CRC_PUBLIC_URL, CRC_HTTP_PORT, and CRC_SESSION_KEY values are still
# accepted for existing deployments; the TRIBUNAL_ names win when both are set.

# Required.
REVIEW_MASTER_KEY=
REVIEW_ADMIN_TOKEN=
TRIBUNAL_SESSION_KEY=
GITLAB_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional defaults for a local Compose run.
TRIBUNAL_PUBLIC_URL=http://localhost:8080
TRIBUNAL_HTTP_PORT=8080
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROTOCOL=openai-chat

# Optional GitLab OAuth browser login, off by default. Uncomment the matching
# lines in config/server.docker.yaml before setting these values.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Admin entry for auth.bootstrap_admins: "id:<GitLab user id>". A plain
# GitLab username still works but is deprecated (see docs/operations.md).
GITLAB_ADMIN_USERNAME=
